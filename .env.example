# Local llama-server or another OpenAI-compatible API (default)
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=local-model
# LLM_API_KEY=

# Optional semantic fallback. Requires an OpenAI-compatible embeddings endpoint.
# SEMANTIC_CONTEXT_ENABLED=true
# EMBEDDING_BASE_URL=http://127.0.0.1:8080
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_API_KEY=

# Anthropic example
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=your-anthropic-model
# ANTHROPIC_API_KEY=
